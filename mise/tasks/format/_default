#!/usr/bin/env bash
# [MISE] description="Format all Typst and Python files in-place"
set -euo pipefail

typstyle \
    --indent-width 4 \
    --line-width 90 \
    --wrap-text \
    --inplace \
    .

# The Python tasks have no .py extension, so ruff only picks them up by name.
ruff format mise/tasks/bump-version/* mise/tasks/package/*
